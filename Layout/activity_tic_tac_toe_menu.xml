<?xml version='1.0' encoding='utf-8'?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/activity_tic_toc_toe_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ttt_background"
    android:fitsSystemWindows="true"
    android:layoutDirection="ltr"
    android:paddingStart="24dp"
    android:paddingTop="16dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">



    <android.widget.Button
        android:id="@+id/tttBackButton"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:background="@drawable/ttt_purple"
        android:backgroundTint="@null"
        android:drawableStart="@drawable/ttt_arrow"
        android:drawablePadding="8dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:singleLine="true"
        android:stateListAnimator="@null"
        android:text="@string/ttt_back"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tttTitle"
        android:layout_width="300dp"
        android:layout_height="70dp"
        android:layout_marginTop="28dp"
        android:background="@drawable/tic_toc_toe_logo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tttBackButton" />

    <ImageView
        android:id="@+id/tttHero"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="16dp"
        android:contentDescription="@string/ttt_art_description"
        android:scaleType="fitCenter"
        android:src="@drawable/ttt_hero"
        app:layout_constraintBottom_toTopOf="@id/tttPanel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_max="220dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tttTitle"
        app:layout_constraintVertical_bias="0.5" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tttPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/ttt_panel"
        android:elevation="4dp"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/tttDifficultyLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/ttt_difficulty"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:visibility="invisible"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <RadioGroup
            android:id="@+id/tttDifficultyGroup"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:checkedButton="@id/tttDifficultyEasy"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tttDifficultyLabel">

            <android.widget.RadioButton
                android:id="@+id/tttBot"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:background="@drawable/ttt_difficulty"
                android:backgroundTint="@null"
                android:button="@null"
                android:gravity="center"
                android:minWidth="0dp"
                android:minHeight="48dp"
                android:padding="4dp"
                android:text="@string/bot"
                android:textColor="@color/ttt_option_text"
                android:textSize="16sp"
                android:textStyle="bold" />


            <android.widget.RadioButton
                android:id="@+id/tttDifficultyEasy"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:background="@drawable/ttt_difficulty"
                android:backgroundTint="@null"
                android:button="@null"
                android:gravity="center"
                android:minWidth="0dp"
                android:minHeight="48dp"
                android:padding="4dp"
                android:text="@string/ttt_easy"
                android:textColor="@color/ttt_option_text"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="invisible"/>

            <android.widget.RadioButton
                android:id="@+id/tttDifficultyMedium"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:background="@drawable/ttt_difficulty"
                android:backgroundTint="@null"
                android:button="@null"
                android:gravity="center"
                android:minWidth="0dp"
                android:minHeight="48dp"
                android:padding="4dp"
                android:text="@string/ttt_medium"
                android:textColor="@color/ttt_option_text"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="invisible"/>

            <android.widget.RadioButton
                android:id="@+id/tttDifficultyHard"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:background="@drawable/ttt_difficulty"
                android:backgroundTint="@null"
                android:button="@null"
                android:gravity="center"
                android:minWidth="0dp"
                android:minHeight="48dp"
                android:padding="4dp"
                android:text="@string/ttt_hard"
                android:textColor="@color/ttt_option_text"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="invisible"/>



        </RadioGroup>

        <android.widget.Button
            android:id="@+id/tttPlayButton"
            android:layout_width="0dp"
            android:layout_height="76dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/ttt_purple"
            android:backgroundTint="@null"
            android:drawableStart="@drawable/ttt_play_icon"
            android:drawablePadding="12dp"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:singleLine="true"
            android:stateListAnimator="@null"
            android:text="@string/ttt_play"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tttDifficultyGroup" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ImageView
        android:id="@+id/imageViewMode"
        android:layout_width="147dp"
        android:layout_height="175dp"
        app:layout_constraintBottom_toBottomOf="@+id/tttHero"
        app:layout_constraintEnd_toEndOf="@+id/tttHero"
        app:layout_constraintHorizontal_bias="0.115"
        app:layout_constraintStart_toStartOf="@+id/tttHero"
        app:layout_constraintTop_toTopOf="@+id/tttHero"
        app:layout_constraintVertical_bias="1.0"
        app:srcCompat="@drawable/easy" />



    <!--- Play Ground -->

    <!-- First Row -->
    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="300dp"
        android:layout_height="75dp"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.495"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.367">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/image1"
            android:layout_width="90dp"
            android:layout_height="70dp"
            android:src="@color/cardview_shadow_end_color" />

        <View
            android:id="@+id/divider1"
            android:layout_width="15dp"
            android:layout_height="75dp"
            android:background="@color/black"
            tools:layout_editor_absoluteX="20dp"
            tools:layout_editor_absoluteY="1dp" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/image2"
            android:layout_width="90dp"
            android:layout_height="70dp"
            android:src="@color/cardview_shadow_end_color" />

        <View
            android:id="@+id/divider2"
            android:layout_width="15dp"
            android:layout_height="75dp"
            android:background="@color/black" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/image3"
            android:layout_width="90dp"
            android:layout_height="70dp"
            android:src="@color/cardview_shadow_end_color" />

    </LinearLayout>

    <!-- First Row Divider -->
    <View
        android:id="@+id/divider13"
        android:layout_width="290dp"
        android:layout_height="15dp"
        android:background="@color/black"
        android:visibility="invisible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout" />

    <!-- Second Row -->
    <LinearLayout
        android:id="@+id/linearLayout2"
        android:layout_width="300dp"
        android:layout_height="75dp"
        android:visibility="invisible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider13">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/image4"
            android:layout_width="90dp"
            android:layout_height="70dp"
            android:layout_marginTop="3dp"
            android:src="@color/cardview_shadow_end_color" />

        <View
            android:id="@+id/divider3"
            android:layout_width="15dp"
            android:layout_height="75dp"
            android:background="@color/black"
            tools:layout_editor_absoluteX="20dp"
            tools:layout_editor_absoluteY="1dp" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/image5"
            android:layout_width="90dp"
            android:layout_height="70dp"
            android:layout_marginTop="3dp"
            android:src="@color/cardview_shadow_end_color" />

        <View
            android:id="@+id/divider4"
            android:layout_width="15dp"
            android:layout_height="75dp"
            android:background="@color/black" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/image6"
            android:layout_width="90dp"
            android:layout_height="70dp"
            android:layout_marginTop="3dp"
            android:src="@color/cardview_shadow_end_color" />

    </LinearLayout>

    <!-- Second Row Divider -->
    <View
        android:id="@+id/divider14"
        android:layout_width="290dp"
        android:layout_height="15dp"
        android:background="@color/black"
        android:visibility="invisible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout2" />


    <!-- Third Row -->
    <LinearLayout
        android:id="@+id/linearLayout3"
        android:layout_width="300dp"
        android:layout_height="75dp"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/linearLayout2"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="@+id/linearLayout2"
        app:layout_constraintTop_toBottomOf="@+id/divider14"
        app:layout_constraintVertical_bias="0.0">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/image7"
            android:layout_width="90dp"
            android:layout_height="70dp"
            android:layout_marginTop="5dp"
            android:src="@color/cardview_shadow_end_color" />

        <View
            android:id="@+id/divider5"
            android:layout_width="15dp"
            android:layout_height="75dp"
            android:background="@color/black"
            tools:layout_editor_absoluteX="20dp"
            tools:layout_editor_absoluteY="1dp" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/image8"
            android:layout_width="90dp"
            android:layout_height="70dp"
            android:layout_marginTop="5dp"
            android:src="@color/cardview_shadow_end_color" />

        <View
            android:id="@+id/divider6"
            android:layout_width="15dp"
            android:layout_height="75dp"
            android:background="@color/black" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/image9"
            android:layout_width="90dp"
            android:layout_height="70dp"
            android:layout_marginTop="5dp"
            android:src="@color/cardview_shadow_end_color" />

    </LinearLayout>

    <View
        android:id="@+id/dividerWin7"
        android:layout_width="15dp"
        android:layout_height="310dp"
        android:background="#CCFFFFFF"
        android:rotation="45"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/dividerWin8"
        android:layout_width="15dp"
        android:layout_height="310dp"
        android:background="#CCFFFFFF"
        android:rotation="-45"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <View
        android:id="@+id/dividerWin3"
        android:layout_width="15dp"
        android:layout_height="260dp"
        android:background="#CCFFFFFF"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="@+id/dividerWin7"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/dividerWin7"
        app:layout_constraintTop_toTopOf="@+id/dividerWin7" />


    <View
        android:id="@+id/dividerWin1"
        android:layout_width="15dp"
        android:layout_height="260dp"
        android:background="#CCFFFFFF"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/dividerWin7"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/dividerWin4"
        android:layout_width="290dp"
        android:layout_height="15dp"
        android:background="#CCFFFFFF"
        android:visibility="invisible"
        app:layout_constraintBottom_toTopOf="@+id/divider13"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/dividerWin1" />

    <View
        android:id="@+id/dividerWin6"
        android:layout_width="300dp"
        android:layout_height="15dp"
        android:background="#CCFFFFFF"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="@+id/linearLayout3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider14" />

    <View
        android:id="@+id/dividerWin5"
        android:layout_width="300dp"
        android:layout_height="15dp"
        android:background="#CDFAF7F7"
        android:visibility="invisible"
        app:layout_constraintBottom_toTopOf="@+id/dividerWin6"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dividerWin4" />

    <View
        android:id="@+id/dividerWin2"
        android:layout_width="15dp"
        android:layout_height="260dp"
        android:background="#CBFFFFFF"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />




    <TextView
        android:id="@+id/exit"
        android:layout_width="45dp"
        android:layout_height="95dp"
        android:text="Exit"
        android:gravity="center"
        android:textSize="15dp"
        android:textColor="@color/white"
        android:rotation="90"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.002"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.52" />


    <TextView
        android:id="@+id/textViewRestart"
        android:layout_width="100sp"
        android:layout_height="40sp"
        android:background="@drawable/menu_footer"
        android:gravity="center"
        android:text="Restart"
        android:textColor="@color/white"
        android:textSize="15dp"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.806" />

</androidx.constraintlayout.widget.ConstraintLayout>