<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D3050"
    tools:context=".MainActivity">

    <!-- Header is constrained to the top, so it does not overlap the cards. -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerSection"
        android:layout_width="0dp"
        android:layout_height="96dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/imageViewSetting"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/music"
            android:backgroundTint="@null"
            android:contentDescription="Music settings"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/coinBalance"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginEnd="12dp"
            android:drawableStart="@drawable/menu_coin_small"
            android:drawablePadding="5dp"
            android:gravity="center"
            android:text="20003"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <ImageView
            android:id="@+id/imageView4"
            android:layout_width="0dp"
            android:layout_height="82dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:scaleType="fitCenter"
            android:contentDescription="2D Game logo"
            app:srcCompat="@drawable/subtitle"
            app:layout_constraintStart_toEndOf="@id/imageViewSetting"
            app:layout_constraintEnd_toStartOf="@id/coinBalance"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Footer remains visible while the middle content scrolls. -->
    <LinearLayout
        android:id="@+id/footerSection"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:background="@drawable/menu_footer"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="72dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.imageview.ShapeableImageView
                android:layout_width="28dp"
                android:layout_height="38dp"
                android:src="@drawable/menu_player_blue"
                android:contentDescription="Blue player" />

            <TextView
                android:id="@+id/blueScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="26sp" />
        </LinearLayout>

        <android.widget.Button
            android:id="@+id/exitButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/menu_exit"
            android:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:text="Exit"
            android:textAllCaps="false"
            android:textColor="#FFC0A7"
            android:textSize="22sp" />

        <LinearLayout
            android:layout_width="72dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="38dp"
                android:src="@drawable/menu_player_orange"
                android:contentDescription="Orange player" />

            <TextView
                android:id="@+id/orangeScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="26sp" />
        </LinearLayout>

    </LinearLayout>

    <!-- 0dp width/height in ConstraintLayout means match constraints,
         NOT 0px. It stretches between the header and footer. -->
    <ScrollView
        android:id="@+id/scrollView2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="8dp"
        android:fillViewport="true"
        android:scrollbars="vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerSection"
        app:layout_constraintBottom_toTopOf="@id/footerSection">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Image height automatically follows the image's native aspect ratio. -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/imageView2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/math_quiz"
                    android:contentDescription="Math Quiz" />

                <ImageButton
                    android:id="@+id/btn_math_quiz"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:layout_gravity="end|bottom"
                    android:layout_marginEnd="24dp"
                    android:layout_marginBottom="19dp"
                    android:background="@drawable/btn_math"
                    android:backgroundTint="@null"
                    android:contentDescription="Play Math Quiz"
                    android:focusableInTouchMode="false" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/imageView3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/missing_number"
                    android:contentDescription="Missing Number" />

                <ImageButton
                    android:id="@+id/button2"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:layout_gravity="end|bottom"
                    android:layout_marginEnd="25dp"
                    android:layout_marginBottom="19dp"
                    android:background="@drawable/btn_missing"
                    android:backgroundTint="@null"
                    android:contentDescription="Play Missing Number" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/imageView5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/city_helicopter"
                    android:contentDescription="City Helicopter" />

                <ImageButton
                    android:id="@+id/button3"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:layout_gravity="end|bottom"
                    android:layout_marginEnd="20dp"
                    android:layout_marginBottom="19dp"
                    android:background="@drawable/btn_city_helicopter"
                    android:backgroundTint="@null"
                    android:contentDescription="Play City Helicopter" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp">

                <ImageView
                    android:id="@+id/imageView6"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/tic_toc_toe"
                    android:contentDescription="Tic Tac Toe" />

                <ImageButton
                    android:id="@+id/button4"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:layout_gravity="end|bottom"
                    android:layout_marginEnd="20dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/btn_tic_toc_toe"
                    android:backgroundTint="@null"
                    android:contentDescription="Play Tic Tac Toe" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp">

                <ImageView
                    android:id="@+id/imageView7"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/space_shoter"
                    android:contentDescription="Space Shooter" />

                <ImageButton
                    android:id="@+id/button5"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:layout_gravity="end|bottom"
                    android:layout_marginEnd="25dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/btn_math"
                    android:backgroundTint="@null"
                    android:contentDescription="Play Space Shooter" />
            </FrameLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
